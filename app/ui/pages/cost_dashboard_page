"""A page whose layout comes from a Qt Designer .ui file."""
from pathlib import Path

from PySide6.QtUiTools import QUiLoader
from PySide6.QtWidgets import QVBoxLayout, QWidget


FORMS_DIR = Path(__file__).parent.parent / "forms"
FORM_NAME = "Cost_Dashboard.ui"


class Cost_Dashboard(QWidget):
    def __init__(self) -> None:
        super().__init__()


        path = FORMS_DIR / FORM_NAME
        if not path.exists():
            raise FileNotFoundError(f"form not found: {path}")



        self.ui = QUiLoader().load(str(path))



        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.addWidget(self.ui)

    def widget(self, name: str):
        return self.ui.findChild(QWidget, name)
