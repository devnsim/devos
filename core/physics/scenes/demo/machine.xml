<!--
  FILE: core/physics/scenes/demo/machine.xml
  OVERVIEW: Demo machine for the physics engine (MuJoCo side): a two-joint arm on a pedestal with a paddle
            that sweeps across the room's loose box and fixture.
  NOTES:
    - [2026-11-16] Created with the physics engine groundwork. Machine geoms use contype=1 / conaffinity=0:
                   no self-collision inside MuJoCo, but they still get Jolt proxies (they collide).
-->
<mujoco model="demo_arm">
  <compiler angle="radian"/>
  <option timestep="0.001" integrator="implicitfast"/>
  <default>
    <geom contype="1" conaffinity="0" rgba="0.55 0.7 0.9 1"/>
    <joint damping="1.0" armature="0.01"/>
    <position kp="60" kv="4" ctrlrange="-3.1 3.1" ctrllimited="true"/>
  </default>
  <worldbody>
    <geom name="pedestal" type="cylinder" size="0.05 0.25" pos="0 0 0.25" contype="0"/>
    <body name="upper_arm" pos="0 0 0.5">
      <joint name="shoulder" type="hinge" axis="0 0 1"/>
      <geom name="upper_link" type="capsule" fromto="0 0 0 0.4 0 0" size="0.03"/>
      <body name="forearm" pos="0.4 0 0">
        <joint name="elbow" type="hinge" axis="0 0 1"/>
        <geom name="fore_link" type="capsule" fromto="0 0 0 0.3 0 0" size="0.025"/>
        <geom name="paddle" type="box" pos="0.3 0 -0.27" size="0.02 0.08 0.17" density="400"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <position name="shoulder_motor" joint="shoulder"/>
    <position name="elbow_motor" joint="elbow"/>
  </actuator>
  <sensor>
    <jointpos name="shoulder_angle" joint="shoulder"/>
    <jointpos name="elbow_angle" joint="elbow"/>
    <jointvel name="shoulder_speed" joint="shoulder"/>
    <actuatorfrc name="shoulder_torque" actuator="shoulder_motor"/>
    <framepos name="paddle_position" objtype="geom" objname="paddle"/>
  </sensor>
</mujoco>
